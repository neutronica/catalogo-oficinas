<h1 class="mb-3">Oficinas cadastradas</h1>

<!-- resumo do catalogo (sempre calculado com todas as oficinas) -->
<p class="mb-3">
  Total de oficinas: <b>{{resumo.total}}</b>
  <span class="ms-2">Abertas: <b>{{resumo.abertas}}</b></span>
  <span class="ms-2">Encerradas: <b>{{resumo.encerradas}}</b></span>
  <span class="ms-2">Carga horária das abertas: <b>{{resumo.cargaHorariaAbertas}} h</b></span>
</p>

<!-- opcoes de visualizacao -->
<ul class="nav nav-pills mb-3">
  <li class="nav-item">
    <a class="nav-link {{#if filtro_todas}}active{{/if}}" href="/">Todas as Oficinas</a>
  </li>
  <li class="nav-item">
    <a class="nav-link {{#if filtro_abertas}}active{{/if}}" href="/abertas">Inscrições Abertas</a>
  </li>
</ul>

{{#if catalogo_vazio}}
  <p class="mb-3">Nenhuma oficina cadastrada.</p>
  <a class="btn btn-primary" href="/oficina/cria">Cadastrar a primeira oficina</a>
{{else}}
  {{#if oficinas.length}}
    <table class="table table-hover align-middle">
      <thead>
        <tr class="table-primary text-center">
          <th>Título</th>
          <th>Carga horária</th>
          <th>Inscrições</th>
          <th>Ações</th>
        </tr>
      </thead>
      <tbody>
        <!-- each eh como um laco for, percorrendo todas as oficinas -->
        {{#each oficinas}}
          <tr>
            <td><b>{{this.titulo}}</b></td>
            <td class="text-center">{{this.cargaHoraria}} h</td>
            <td class="text-center">{{#if this.inscricoesAbertas}}Abertas{{else}}Encerradas{{/if}}</td>
            <td class="text-center">
              <a class="btn btn-primary btn-sm" href="/oficina/consulta/{{this.id}}">Consultar</a>
              <a class="btn btn-primary btn-sm" href="/oficina/altera/{{this.id}}">Editar</a>
              <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#modalExclui{{this.id}}">Excluir</button>
              <a class="btn btn-outline-primary btn-sm" href="/oficina/alterna/{{this.id}}">{{#if this.inscricoesAbertas}}Encerrar{{else}}Reabrir{{/if}}</a>

              <!-- janela modal de confirmacao da exclusao -->
              <div class="modal fade text-start" id="modalExclui{{this.id}}" tabindex="-1" aria-labelledby="tituloModal{{this.id}}" aria-hidden="true">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h1 class="modal-title fs-5" id="tituloModal{{this.id}}">Excluir oficina</h1>
                      <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                    </div>
                    <div class="modal-body">
                      Confirma a exclusão de <b>{{this.titulo}}</b>?
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                      <a class="btn btn-danger" href="/oficina/deleta/{{this.id}}">Confirmar</a>
                    </div>
                  </div>
                </div>
              </div>
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p>Nenhuma oficina está com inscrições abertas</p>
  {{/if}}
{{/if}}
